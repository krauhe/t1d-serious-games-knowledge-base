{
  "name": "t1d-serious-games-knowledge-base",
  "version": "0.1.0",
  "private": true,
  "description": "Scientific knowledge base for discovering, designing, evaluating, and sustaining serious games relevant to type 1 diabetes.",
  "homepage": "https://krauhe.github.io/t1d-serious-games-knowledge-base/",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node tools/build-site.mjs",
    "build:private": "node tools/build-site.mjs --private-images",
    "build:tablet": "node tools/build-site.mjs --private-images && node tools/build-tablet.mjs",
    "normalise:catalogue": "node tools/normalise-catalogue.mjs",
    "validate": "node tools/validate.mjs",
    "validate:links": "node tools/check-external-links.mjs",
    "check": "pnpm run validate && pnpm run build"
  },
  "devDependencies": {
    "marked": "17.0.5"
  }
}
