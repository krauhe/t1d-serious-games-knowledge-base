endobj

135 0 obj
<</Dest[18 0 R/Fit]/Next 136 0 R/Parent 126 0 R/Prev 134 0 R/Title(F01 - Major: twelve misidentified physiological references)>>
endobj

136 0 obj
<</Dest[25 0 R/Fit]/Next 137 0 R/Parent 126 0 R/Prev 135 0 R/Title(F02 - Major: a controlled study is created from an uncontrolled pilot)>>
endobj

137 0 obj
<</Dest[25 0 R/Fit]/Next 138 0 R/Parent 126 0 R/Prev 136 0 R/Title(F03 - Major: eddii's outcome evidence is materially understated)>>
endobj

138 0 obj
<</Dest[31 0 R/Fit]/Next 139 0 R/Parent 126 0 R/Prev 137 0 R/Title(F04 - Major: I Got This has the wrong disease and provenance)>>
endobj

139 0 obj
<</Dest[31 0 R/Fit]/Next 140 0 R/Parent 126 0 R/Prev 138 0 R/Title(F05 - Major: mixed-diabetes findings are labelled direct T1D evidence)>>
endobj

140 0 obj
<</Dest[31 0 R/Fit]/Next 141 0 R/Parent 126 0 R/Prev 139 0 R/Title(F06 - Major: non-release is converted into disappearance)>>
endobj

141 0 obj
<</Dest[35 0 R/Fit]/Next 142 0 R/Parent 126 0 R/Prev 140 0 R/Title(F07 - Major: sustainability hypotheses become established causal explanations)>>
endobj

142 0 obj
<</Dest[35 0 R/Fit]/Next 143 0 R/Parent 126 0 R/Prev 141 0 R/Title(F08 - Major: historical search reproducibility is overstated)>>
endobj

143 0 obj
<</Dest[35 0 R/Fit]/Next 144 0 R/Parent 126 0 R/Prev 142 0 R/Title(F09 - Major: study extraction is incomplete despite a complete-looking schema)>>
endobj

144 0 obj
<</Dest[38 0 R/Fit]/Next 145 0 R/Parent 126 0 R/Prev 143 0 R/Title(F10 - Major: Qare and Qure's paired-caregiver interpretation is unverified)>>
endobj

145 0 obj
<</Dest[38 0 R/Fit]/Next 146 0 R/Parent 126 0 R/Prev 144 0 R/Title(F11 - Major: prescriptive learning claims exceed their cited support)>>
endobj

146 0 obj
<</Dest[43 0 R/Fit]/Next 147 0 R/Parent 126 0 R/Prev 145 0 R/Title(F12 - Minor: the five-to-eight-user heuristic needs qualification)>>
endobj

147 0 obj
<</Dest[43 0 R/Fit]/Next 148 0 R/Parent 126 0 R/Prev 146 0 R/Title(F13 - Major: field-wide absence claims lack reproducible bounds)>>
endobj

148 0 obj
<</Dest[43 0 R/Fit]/Next 149 0 R/Parent 126 0 R/Prev 147 0 R/Title(F14 - Minor: platform and availability representations disagree)>>
endobj

149 0 obj
<</Dest[44 0 R/Fit]/Next 150 0 R/Parent 126 0 R/Prev 148 0 R/Title(F15 - Minor: bibliographic metadata needs a second pass beyond wrong identifiers)>>
endobj

150 0 obj
<</Dest[44 0 R/Fit]/Next 151 0 R/Parent 126 0 R/Prev 149 0 R/Title(F16 - Major: quantitative physiology is not consistently anchored to context)>>
endobj

151 0 obj
<</Dest[44 0 R/Fit]/Next 152 0 R/Parent 126 0 R/Prev 150 0 R/Title(F17 - Major: endpoint labels obscure what was measured)>>
endobj

152 0 obj
<</Dest[49 0 R/Fit]/Next 153 0 R/Parent 126 0 R/Prev 151 0 R/Title(F18 - Major: numerical accuracy is not the same as methodological credibility)>>
endobj

153 0 obj
<</Dest[49 0 R/Fit]/Next 154 0 R/Parent 126 0 R/Prev 152 0 R/Title(F19 - Major: useful comparator literature is omitted or disconnected)>>
endobj

154 0 obj
<</Dest[53 0 R/Fit]/Next 155 0 R/Parent 126 0 R/Prev 153 0 R/Title(F20 - Minor: \215neutral\216 comparison still contains unlabelled preferences)>>
endobj

155 0 obj
<</Dest[53 0 R/Fit]/Next 156 0 R/Parent 126 0 R/Prev 154 0 R/Title(F21 - Major: source acquisition was too narrowly governed and incompletely tracked)>>
endobj

